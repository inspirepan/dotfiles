.DS_Store
*.secret
*.local

# Agent credentials and mutable settings are never stowed.
claude/.claude/settings*.json
klaude/.klaude/*auth*.json

# jj per-repo configs (machine-specific, contain absolute paths)
config/.config/jj/repos/

# Karabiner auto-generated backups
config/.config/karabiner/automatic_backups/

# Zed auto-generated prompt library database
config/.config/zed/prompts/
